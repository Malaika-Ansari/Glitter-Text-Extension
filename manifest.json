{
  "manifest_version": 3,
  "name": "GlitterText - Sparkle & Glitter Text Customizer",
  "short_name": "GlitterText",
  "version": "1.0.0",
  "description": "Customize webpage text with realistic gold glitter, shimmering metallic accents, and sparkling particle effects.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GlitterText - Sparkle Text Customizer"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content/glitter.css"
      ],
      "js": [
        "shared/config.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ]
}

